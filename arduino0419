#include <SPI.h>
#include <MFRC522.h>

#define S1 A3
#define S2 A4
#define S3 A5
#define S4 A6
#define S5 A7
int PWMA = 10, AIN2 = 6, AIN1 = 7, BIN1 = 8, BIN2 = 9, PWMB = 11;

// 🌟 動力再次提升，確保起步不卡死
int Tp = 130; 
double Kp = 40, Kd = 60, lastError = 0; 
int mid = 80; 

#define RST_PIN 49
#define SS_PIN 53
MFRC522 mfrc522(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(9600); Serial3.begin(9600); // 接藍牙
  pinMode(13, OUTPUT);
  pinMode(S1, INPUT); pinMode(S2, INPUT); pinMode(S3, INPUT); pinMode(S4, INPUT); pinMode(S5, INPUT);
  pinMode(PWMA, OUTPUT); pinMode(AIN1, OUTPUT); pinMode(AIN2, OUTPUT);
  pinMode(BIN1, OUTPUT); pinMode(BIN2, OUTPUT); pinMode(PWMB, OUTPUT);
  SPI.begin(); mfrc522.PCD_Init();
  
  // 閃三下代表開機成功
  for(int i=0; i<3; i++) { digitalWrite(13,HIGH); delay(100); digitalWrite(13,LOW); delay(100); }
}

void MotorWriting(int vL, int vR) {
  if (vL >= 0) { digitalWrite(AIN1, HIGH); digitalWrite(AIN2, LOW); analogWrite(PWMA, min(vL, 255)); }
  else { digitalWrite(AIN1, LOW); digitalWrite(AIN2, HIGH); analogWrite(PWMA, min(-vL, 255)); }
  if (vR >= 0) { digitalWrite(BIN1, HIGH); digitalWrite(BIN2, LOW); analogWrite(PWMB, min(vR, 255)); }
  else { digitalWrite(BIN1, LOW); digitalWrite(BIN2, HIGH); analogWrite(PWMB, min(-vR, 255)); }
}

void moveOneNode() {

  MotorWriting(Tp, Tp);
  delay(400);

  unsigned long t = millis();

  while (true) {

    int s1 = analogRead(S1);
    int s2 = analogRead(S2);
    int s3 = analogRead(S3);
    int s4 = analogRead(S4);
    int s5 = analogRead(S5);

    // 🔥 DEBUG（建議打開）
    // Serial.println(s3);

    // ✔ 成功到節點
    if (s1 >= mid && s5 >= mid) {
      MotorWriting(120, 120);
      delay(400);
      MotorWriting(0, 0);
      break;
    }

    int e =
      (s1 >= mid ? -2 : 0) +
      (s2 >= mid ? -1 : 0) +
      (s4 >= mid ? 1 : 0) +
      (s5 >= mid ? 2 : 0);

    double pCorr = Kp * e + Kd * (e - lastError);

    MotorWriting(Tp + pCorr, Tp - pCorr);
    lastError = e;

    // 🔥 防卡死（超重要）
    if (millis() - t > 3000) {
      MotorWriting(0, 0);
      break;
    }
  }
}

void turnLeft90() { MotorWriting(-120, 120); delay(300); while(analogRead(S3)<mid){MotorWriting(-80,80);} MotorWriting(100,-100); delay(120); MotorWriting(0,0); }
void turnRight90() { MotorWriting(120, -120); delay(300); while(analogRead(S3)<mid){MotorWriting(80,-80);} MotorWriting(-100,100); delay(120); MotorWriting(0,0); }
void turnAround() { MotorWriting(130, -130); delay(500); while(analogRead(S3)<mid){MotorWriting(80,-80);} MotorWriting(-100,100); delay(120); MotorWriting(0,0); }

void loop() {
  if (Serial3.available()) {
    char cmd = Serial3.read();
    if (cmd == 'W' || cmd == 'A' || cmd == 'D' || cmd == 'S') {
      digitalWrite(13, HIGH); // 收到指令亮燈
      if (cmd == 'W') moveOneNode();
      else if (cmd == 'A') turnLeft90();
      else if (cmd == 'D') turnRight90();
      else if (cmd == 'S') turnAround();
      
      // RFID 掃描
      if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
        String uid = "";
        for (byte i = 0; i < mfrc522.uid.size; i++) {
          if (mfrc522.uid.uidByte[i] < 0x10) uid += "0";
          uid += String(mfrc522.uid.uidByte[i], HEX);
        }
        uid.toUpperCase();
        Serial3.print("UID:" + uid + ",");
        mfrc522.PICC_HaltA(); mfrc522.PCD_StopCrypto1();
      }
      
      while(Serial3.available()) Serial3.read(); // 清空雜訊
      Serial3.print('K'); 
      digitalWrite(13, LOW); 
      delay(250); 
    }
  }
}
